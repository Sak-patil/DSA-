    Node(int data){
        this.data=data;
        this.next=null;
    }
}
public class main{
    static boolean search(Node head,int target){
        Node temp=head;
        while(temp!=null){
            if(temp.data==target){
                return true;
            }
            temp=temp.next;
        }
        return false;
    }

    static Node insertAtBeginning(Node head,int element){
        Node new_node=new Node(element);
        new_node.next=head;
        head=new_node;
        return head;
    }

    static Node deletefrombeginning(Node head){
        head=head.next;
        return head;
    }

    static Node insertarend(Node head,int element){
        Node temp=head;
        while(temp.next!=null){
            temp=temp.next;
        }
        Node end=new Node(element);
        temp.next=end;
        end.next=null;
        return head;
    }

    static Node deleteatend(Node head){
        Node temp=head;
        while(temp.next.next!=null){
            temp=temp.next;
        }
        temp.next=null;
        return head;
    }

    static Node insertatposition(Node head,int position,int data){
        Node temp=head;
        int k=1;
        while(k!=position-1){
            temp=temp.next;
            k++;
        }
        Node newnode=new Node(data);
        newnode.next=temp.next;
        temp.next=newnode;
        return head; 
    }

    static Node deletefromposition(Node head,int position){
        Node temp=head;
        int k=1;
        while(k!=position-1){
            temp=temp.next;
            k++;
        }
        temp.next=temp.next.next;
        return head;
    }

    static Node reverselink(Node head){
        if(head==null || head.next==null){
            return head;
        }
        else{
            Node current=head;
            Node prev=null;
            Node next;
            
            while(current!=null){
                next=current.next;
                current.next=prev;
                prev=current;
                current=next;            
            }
            return prev;
        }
    }

    static Node middle(Node head){
        Node slow=head;
        Node fast=head;
        while(fast!=null && fast.next!=null){
            slow=slow.next;
            fast=fast.next.next;
        }
        Node middle=slow;
        return middle;
    }

    static boolean cycle(Node head){
        Node slow=head;
        Node fast=head;
        while(fast!=null && fast.next!=null){
            slow=slow.next;
            fast=fast.next.next;
            if(slow == fast) {
                return true;
            }
        }
            return false;
    }

